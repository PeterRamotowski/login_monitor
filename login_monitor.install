<?php

/**
 * @file
 * Update hooks for the Login Monitor module.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Unicode;
use Drupal\Core\Config\FileStorage;
use Drupal\login_monitor\LoginMonitorLimits;

/**
 * Remove user_id, uid fields.
 */
function login_monitor_update_8001() {
  $entityDefinitionUpdateManager = \Drupal::entityDefinitionUpdateManager();
  $fieldStorageDefinition = $entityDefinitionUpdateManager
    ->getFieldStorageDefinition('user_id', 'login_log');
  if ($fieldStorageDefinition) {
    $entityDefinitionUpdateManager
      ->uninstallFieldStorageDefinition($fieldStorageDefinition);
  }
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  \Drupal::service('router.builder')->rebuild();

  return t('Successfully removed user_id field references.');
}

/**
 * Update null typed_username fields with display name from associated user.
 */
function login_monitor_update_8002() {
  $database = \Drupal::database();
  $entityTypeManager = \Drupal::entityTypeManager();

  $query = $database->select('login_log', 'll')
    ->fields('ll', ['id', 'uid'])
    ->condition('ll.typed_username', NULL, 'IS NULL')
    ->condition('ll.uid', NULL, 'IS NOT NULL');

  $results = $query->execute()->fetchAll();

  $updatedCount = 0;

  foreach ($results as $record) {
    try {
      /** @var \Drupal\Core\Session\AccountInterface $user */
      $user = $entityTypeManager->getStorage('user')->load($record->uid);

      if ($user) {
        $database->update('login_log')
          ->fields(['typed_username' => $user->getDisplayName()])
          ->condition('id', $record->id)
          ->execute();

        $updatedCount++;
      }
    }
    catch (\Exception $e) {
      \Drupal::logger('login_monitor')->error('Failed to update typed_username for login_log ID @id: @message', [
        '@id' => $record->id,
        '@message' => $e->getMessage(),
      ]);
    }
  }

  return t('Successfully updated @count login log entries with user display names.', ['@count' => $updatedCount]);
}

/**
 * Refresh the login log list view.
 */
function login_monitor_update_8003() {
  $configFactory = \Drupal::configFactory();
  $viewConfig = $configFactory->getEditable('views.view.login_log_list');

  $viewConfigPath = \Drupal::service('extension.list.module')->getPath('login_monitor') . '/config/optional';
  $viewConfigStorage = new FileStorage($viewConfigPath);
  $viewConfigData = $viewConfigStorage->read('views.view.login_log_list.yml');
  $viewConfig->setData($viewConfigData)->save(TRUE);

  return t('Successfully updated the login log list view.');
}

/**
 * Add notification limits and cap stored user agent values.
 */
function login_monitor_update_8004() {
  $config = \Drupal::configFactory()->getEditable('login_monitor.settings');
  if ($config->get('notification_rate_limit') === NULL) {
    $config->set('notification_rate_limit', 10);
  }
  if ($config->get('log_retention_days') !== NULL) {
    $config->set('log_retention_days', (int) $config->get('log_retention_days'));
  }
  $config->save(TRUE);

  $storage = \Drupal::entityTypeManager()->getStorage('login_log');
  $lastId = 0;
  do {
    $ids = $storage->getQuery()
      ->condition('id', $lastId, '>')
      ->accessCheck(FALSE)
      ->sort('id')
      ->range(0, 100)
      ->execute();

    if (empty($ids)) {
      break;
    }

    $logs = $storage->loadMultiple($ids);
    foreach ($logs as $log) {
      /** @var \Drupal\login_monitor\Entity\LoginLogInterface $log */
      $userAgent = $log->getUserAgent();
      if ($userAgent === NULL) {
        continue;
      }

      $truncatedUserAgent = Unicode::truncate($userAgent, LoginMonitorLimits::USER_AGENT_MAX_LENGTH, TRUE, FALSE);
      if ($truncatedUserAgent !== $userAgent) {
        $log->setUserAgent($truncatedUserAgent);
        $log->save();
      }
    }

    $lastId = (int) max($ids);
  } while (count($ids) === 100);

  $fieldStorageDefinitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('login_log');
  if (isset($fieldStorageDefinitions['user_agent'])) {
    // Alter the database column directly to bypass Drupal's data-migration
    // guard, which blocks updateFieldStorageDefinition() on tables with data.
    // Expanding a VARCHAR column is safe and requires no data migration.
    $database = \Drupal::database();
    if ($database->schema()->fieldExists('login_log', 'user_agent')) {
      $database->schema()->changeField('login_log', 'user_agent', 'user_agent', [
        'type' => 'varchar',
        'length' => LoginMonitorLimits::USER_AGENT_MAX_LENGTH,
        'not null' => FALSE,
      ]);
    }

    // Sync the last-installed definition so the entity update tracker agrees
    // with the new column size without requiring a subsequent update run.
    \Drupal::service('entity.last_installed_schema.repository')
      ->setLastInstalledFieldStorageDefinition($fieldStorageDefinitions['user_agent']);
  }

  return t('Updated notification limits and user agent storage.');
}

/**
 * Add notification_delivery configuration setting.
 */
function login_monitor_update_8005() {
  $config = \Drupal::configFactory()->getEditable('login_monitor.settings');
  if ($config->get('notification_delivery') === NULL) {
    $config->set('notification_delivery', 'immediate')->save(TRUE);
  }

  return t('Added notification_delivery configuration setting.');
}

/**
 * Migrate last-report timestamps from config to State API.
 */
function login_monitor_update_8006(): string {
  $config = \Drupal::configFactory()->getEditable('login_monitor.settings');
  $state = \Drupal::state();

  foreach (['daily', 'weekly', 'monthly'] as $freq) {
    $configKey = 'last_' . $freq . '_report';
    $value = $config->get($configKey);
    if ($value !== NULL && (int) $value > 0) {
      $state->set('login_monitor.last_report.' . $freq, (int) $value);
    }
    $config->clear($configKey);
  }

  $config->save(TRUE);

  return (string) t('Migrated last-report timestamps from config to State API.');
}
